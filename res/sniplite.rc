#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

#ifdef SNIPLITE_CLI
1 RT_MANIFEST "cli.manifest"
#define FILE_DESC "sniplite command line"
#define FILE_NAME "sniplite.com"
#else
1 RT_MANIFEST "sniplite.manifest"
#define FILE_DESC "sniplite screenshot tool"
#define FILE_NAME "sniplite.exe"

IDI_APP ICON "sniplite.ico"

/* The dialogs give the places and sizes only. Every text is set when a dialog opens,
 * from src/lang_text.h, and the font named here is replaced by the font of the
 * language in use (src/lang.c). Controls are wide and tall enough for the longest
 * language. */

/* Preferences: compact window, tabs on top, one page per area. */
IDD_SETTINGS DIALOGEX 0, 0, 238, 198
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "sniplite"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL         "", IDC_TABS, "SysTabControl32", WS_TABSTOP, 6, 6, 226, 186
END

IDD_PAGE_GENERAL DIALOGEX 0, 0, 220, 166
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    AUTOCHECKBOX    "", IDC_AUTOSTART, 8, 6, 204, 12, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_TRAY, 8, 20, 204, 12, WS_TABSTOP
    AUTOCHECKBOX    "", IDC_PIN_TOP, 8, 34, 204, 12, WS_TABSTOP
    LTEXT           "", IDC_LANG_LABEL, 8, 52, 38, 10
    COMBOBOX        IDC_LANG, 48, 50, 96, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX        "", IDC_INI_GROUP, 8, 66, 204, 48
    LTEXT           "", IDC_PATH_LABEL, 16, 79, 30, 10
    EDITTEXT        IDC_INI_PATH, 48, 77, 156, 13, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "", IDC_OPEN_DIR, 16, 94, 72, 15
    PUSHBUTTON      "", IDC_OPEN_INI, 154, 94, 50, 15
    LTEXT           "", IDC_QUICK_LABEL, 8, 119, 204, 10
    EDITTEXT        IDC_QUICK_DIR, 8, 130, 150, 13, ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "", IDC_QUICK_PICK, 162, 129, 50, 15
    CONTROL         "", IDC_HELPBTN, "Button", BS_OWNERDRAW | WS_TABSTOP, 8, 148, 13, 13
    PUSHBUTTON      "", IDC_DEFAULTS, 152, 147, 60, 15
END

IDD_PAGE_CAPTURE DIALOGEX 0, 0, 220, 166
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_MODE_LABEL, 8, 10, 40, 10
    AUTORADIOBUTTON "", IDC_DXGI, 50, 9, 74, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "", IDC_GDI, 128, 9, 84, 12
    LTEXT           "", IDC_HINT, 8, 28, 204, 44
    LTEXT           "", IDC_THEME_LABEL, 8, 82, 84, 10
    COMBOBOX        IDC_THEME, 94, 80, 96, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "", IDC_EXIT_ASK, 8, 100, 204, 12, WS_TABSTOP
    PUSHBUTTON      "", IDC_DEFAULTS, 152, 147, 60, 15
END

IDD_PAGE_HOTKEYS DIALOGEX 0, 0, 220, 166
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_HK_LABEL1, 8, 10, 72, 10
    CONTROL         "", IDC_HK_FIELD1, "sniplite.hotkey", WS_TABSTOP, 82, 7, 100, 14
    CONTROL         "", IDC_HK_CLEAR1, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 8, 12, 12
    CONTROL         "", IDC_HK_STATE1, "Static", SS_OWNERDRAW, 201, 8, 12, 12
    LTEXT           "", IDC_HK_LABEL2, 8, 28, 72, 10
    CONTROL         "", IDC_HK_FIELD2, "sniplite.hotkey", WS_TABSTOP, 82, 25, 100, 14
    CONTROL         "", IDC_HK_CLEAR2, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 26, 12, 12
    CONTROL         "", IDC_HK_STATE2, "Static", SS_OWNERDRAW, 201, 26, 12, 12
    LTEXT           "", IDC_HK_LABEL3, 8, 46, 72, 10
    CONTROL         "", IDC_HK_FIELD3, "sniplite.hotkey", WS_TABSTOP, 82, 43, 100, 14
    CONTROL         "", IDC_HK_CLEAR3, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 44, 12, 12
    CONTROL         "", IDC_HK_STATE3, "Static", SS_OWNERDRAW, 201, 44, 12, 12
    LTEXT           "", IDC_HK_LABEL4, 8, 64, 72, 10
    CONTROL         "", IDC_HK_FIELD4, "sniplite.hotkey", WS_TABSTOP, 82, 61, 100, 14
    CONTROL         "", IDC_HK_CLEAR4, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 62, 12, 12
    CONTROL         "", IDC_HK_STATE4, "Static", SS_OWNERDRAW, 201, 62, 12, 12
    LTEXT           "", IDC_HK_LABEL5, 8, 82, 72, 10
    CONTROL         "", IDC_HK_FIELD5, "sniplite.hotkey", WS_TABSTOP, 82, 79, 100, 14
    CONTROL         "", IDC_HK_CLEAR5, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 80, 12, 12
    CONTROL         "", IDC_HK_STATE5, "Static", SS_OWNERDRAW, 201, 80, 12, 12
    LTEXT           "", IDC_HK_LABEL6, 8, 100, 72, 10
    CONTROL         "", IDC_HK_FIELD6, "sniplite.hotkey", WS_TABSTOP, 82, 97, 100, 14
    CONTROL         "", IDC_HK_CLEAR6, "Button", BS_OWNERDRAW | WS_TABSTOP, 186, 98, 12, 12
    CONTROL         "", IDC_HK_STATE6, "Static", SS_OWNERDRAW, 201, 98, 12, 12
    LTEXT           "", IDC_HINT, 8, 118, 204, 20
    PUSHBUTTON      "", IDC_BUILTIN, 8, 147, 60, 15
    PUSHBUTTON      "", IDC_DEFAULTS, 152, 147, 60, 15
END

/* Asked before a capture with a selection is left: where the mouse is. */
IDD_LEAVE DIALOGEX 0, 0, 176, 64
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTERMOUSE | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "sniplite"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_L_TEXT, 10, 10, 156, 10
    AUTOCHECKBOX    "", IDC_L_ASK, 10, 26, 156, 12, WS_TABSTOP
    DEFPUSHBUTTON   "", IDOK, 58, 43, 52, 15
    PUSHBUTTON      "", IDCANCEL, 114, 43, 52, 15
END

IDD_SHORTCUTS DIALOGEX 0, 0, 252, 250
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "sniplite"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    CONTROL         "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 7, 7, 238, 216
    DEFPUSHBUTTON   "", IDOK, 188, 229, 57, 15
END

IDD_PAGE_UPDATE DIALOGEX 0, 0, 220, 166
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_U_VERSION, 8, 10, 204, 10
    PUSHBUTTON      "", IDC_U_CHECK, 8, 26, 60, 15
    LTEXT           "", IDC_U_STATUS, 74, 29, 138, 10
    PUSHBUTTON      "", IDC_U_INSTALL, 8, 46, 60, 15
    AUTOCHECKBOX    "", IDC_U_AUTO, 8, 70, 204, 12, WS_TABSTOP
    LTEXT           "", IDC_HINT, 8, 86, 204, 20
    PUSHBUTTON      "", IDC_DEFAULTS, 152, 147, 60, 15
END

IDD_PAGE_OCR DIALOGEX 0, 0, 220, 166
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT           "", IDC_O_STATE, 8, 10, 204, 10
    PUSHBUTTON      "", IDC_O_INSTALL, 8, 26, 110, 15
    PUSHBUTTON      "", IDC_O_REMOVE, 124, 26, 60, 15
    CONTROL         "", IDC_O_BAR, "msctls_progress32", 0, 8, 47, 204, 7
    LTEXT           "", IDC_O_STATUS, 8, 58, 204, 10
    LTEXT           "", IDC_HINT, 8, 74, 204, 62
END

IDD_PAGE_ABOUT DIALOGEX 0, 0, 220, 166
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    ICON            IDI_APP, -1, 8, 10, 20, 20
    LTEXT           "", IDC_VERSION, 38, 10, 174, 12
    LTEXT           "", IDC_TAGLINE, 38, 25, 174, 10
    LTEXT           "", IDC_LICENSE, 38, 39, 174, 10
    PUSHBUTTON      "", IDC_PROJECT, 8, 147, 140, 15
END
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,4,1,0
PRODUCTVERSION 1,4,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", FILE_DESC
      VALUE "FileVersion", "1.4.1"
      VALUE "ProductName", "sniplite"
      VALUE "ProductVersion", "1.4.1"
      VALUE "OriginalFilename", FILE_NAME
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
